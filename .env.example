# Set to your verified public origin before a production build.
# Leave unset for previews (robots disallows crawling; sitemap is empty).
SITE_URL=

# Protected website content editor. Use unique values for production.
CONTENT_ADMIN_PIN=
CONTENT_SESSION_SECRET=
# Neon PostgreSQL and admin authentication.
DATABASE_URL=
# Neon pooled URL above; optional direct URL for Prisma migrations below.
DIRECT_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set only when a trusted reverse proxy overwrites incoming IP headers.
TRUST_PROXY=false

# Optional real outbound delivery. Never expose these as NEXT_PUBLIC variables.
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Optional hosted card checkout and verified card refunds.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary server credentials. Never use NEXT_PUBLIC_ for the API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=falakrides
